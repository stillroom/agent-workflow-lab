# Copy to .env (gitignored) and edit. Never commit the real thing.
#
#   cp .env.example .env
#
# Only the optional live Jev call needs a key. The default judgment source is a
# stub, so the test suite runs with no key and spends nothing.
#
# How the key is resolved, first hit wins:
#   1. TYPESAFE_API_KEY already exported in your shell
#   2. TYPESAFE_API_KEY in .env (below)
#   3. TYPESAFE_ENV_FILE in .env, pointing at a file that sets TYPESAFE_API_KEY


# --- Option A: point at a file that already holds the key -------------------
# Keep secrets out of this repo entirely. Relative paths resolve against the
# directory holding this .env; `~` is expanded.
#
# TYPESAFE_ENV_FILE=~/.config/my-secrets/typesafe.env
# TYPESAFE_ENV_FILE=../private/env/typesafe.env


# --- Option B: put the key here --------------------------------------------
#
# TYPESAFE_API_KEY=


# --- Optional overrides ----------------------------------------------------

# Where this repo looks for a .env. Defaults to <repo>/.env.
# AGENT_LAB_ENV_FILE=

# Point the SDK at a different endpoint (see the typesafe-sdk constants).
# TYPESAFE_BASE_URL=

# Which judgment source a run uses: stub (default) | recorded | jev.
# AGENT_LAB_JUDGMENT=stub
